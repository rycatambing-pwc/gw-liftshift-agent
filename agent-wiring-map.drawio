        <mxCell id="skillLobPlan" value="SKILL&#10;pc-plan-lob-removal&#10;Generates LOB-removal plan" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#F7E6D2;strokeColor=#C17324;dashed=1;dashPattern=6 4;fontFamily=Courier New;fontSize=11.5;fontStyle=1" vertex="1" parent="1">
