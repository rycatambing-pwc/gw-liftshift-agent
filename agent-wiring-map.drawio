        <mxCell id="e_pcf_skills" style="edgeStyle=none;rounded=0;strokeColor=#3457C9;strokeWidth=2;endArrow=block;endFill=1;html=1;exitX=0.7;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="agentPcf" target="skillPcfSkills">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Context box + elbow arrow into gw-pcf-agent -->
        <mxCell id="context" value="CONTEXT&#10;/context/pcf&#10;Pulled on demand — never preloaded" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=none;strokeColor=#9AA3B2;dashed=1;dashPattern=4 4;fontFamily=Courier New;fontSize=11.5;fontStyle=1;fontColor=#5B6473" vertex="1" parent="1">
          <mxGeometry x="1120" y="390" width="280" height="68" as="geometry" />
        </mxCell>
        <mxCell id="e_context_pcf" style="edgeStyle=orthogonalEdgeStyle;rounded=0;dashed=1;dashPattern=5 4;strokeColor=#9AA3B2;strokeWidth=1.8;endArrow=block;endFill=1;html=1;exitX=0.5;exitY=0;entryX=0.9;entryY=1" edge="1" parent="1" source="context" target="agentPcf">
          <mxGeometry relative="1" as="geometry">
            <Array as="points">
              <mxPoint x="1260" y="280" />
              <mxPoint x="1046" y="280" />
            </Array>
          </mxGeometry>
        </mxCell>

        <!-- Orphan row -->
        <mxCell id="skillGosuFind" value="SKILL&#10;gosu-find-usages&#10;No gosu agent in this scope" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=12;fillColor=#F7E6D2;strokeColor=#C17324;dashed=1;dashPattern=6 4;fontFamily=Courier New;fontSize=11.5;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="90" y="390" width="260" height="68" as="geometry" />
