        <mxCell id="legendRules" value="Rules — auto-injected for every session, not agent-specific" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#1F8F6A" vertex="1" parent="1">
          <mxGeometry x="820" y="500" width="360" height="20" as="geometry" />
