        <mxCell id="legendWired" value="Wired — the agent file actually invokes this skill" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#3457C9" vertex="1" parent="1">
          <mxGeometry x="40" y="500" width="360" height="20" as="geometry" />
        </mxCell>
        <mxCell id="legendGap" value="Documented, not wired — described but no file calls it" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#C17324" vertex="1" parent="1">
          <mxGeometry x="420" y="500" width="380" height="20" as="geometry" />
