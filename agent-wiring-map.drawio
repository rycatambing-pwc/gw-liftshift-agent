        <!-- Rules -> agents connectors -->
        <mxCell id="e_rules_build" style="edgeStyle=none;rounded=0;dashed=1;dashPattern=5 4;strokeColor=#1F8F6A;strokeWidth=2;endArrow=block;endFill=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="rules" target="agentBuild">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e_rules_entity" style="edgeStyle=none;rounded=0;dashed=1;dashPattern=5 4;strokeColor=#1F8F6A;strokeWidth=2;endArrow=block;endFill=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="rules" target="agentEntity">
          <mxGeometry relative="1" as="geometry" />
