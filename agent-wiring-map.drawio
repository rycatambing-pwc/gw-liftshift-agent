        <mxCell id="legendGhost" value="Context / excluded — on-demand only, or out of scope" style="text;html=1;align=left;verticalAlign=middle;fontFamily=Helvetica;fontSize=11;fontColor=#5B6473" vertex="1" parent="1">
          <mxGeometry x="1190" y="500" width="330" height="20" as="geometry" />
