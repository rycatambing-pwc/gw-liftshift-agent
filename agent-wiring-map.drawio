<mxfile host="app.diagrams.net">
  <diagram name="Agent Wiring Map" id="agent-wiring-map">
    <mxGraphModel dx="1400" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="560" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Rules band -->
        <mxCell id="rules" value="RULES&#10;Auto-loaded into every session in this project — applies regardless of which agent is running" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#DCF1E8;strokeColor=#1F8F6A;fontColor=#14523C;fontFamily=Courier New;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="24" width="1360" height="50" as="geometry" />
        </mxCell>

        <!-- Agent boxes -->
        <mxCell id="agentBuild" value="AGENT&#10;gw-build-agent&#10;Gradle builds &amp; compile diagnostics" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#5B6473;fontFamily=Courier New;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="agentEntity" value="AGENT&#10;gw-entity-agent&#10;Entity XML (.eti/.etx) for ORM codegen" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#5B6473;fontFamily=Courier New;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="393" y="140" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="agentPcf" value="AGENT&#10;gw-pcf-agent&#10;PCF UI configuration (screens, views)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#5B6473;fontFamily=Courier New;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="746" y="140" width="300" height="90" as="geometry" />
        </mxCell>
        <mxCell id="agentTypelist" value="AGENT&#10;gw-typelist-agent&#10;Typelist codes (.tti/.ttx)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;align=left;verticalAlign=middle;spacingLeft=14;fillColor=#FFFFFF;strokeColor=#5B6473;fontFamily=Courier New;fontSize=12;fontStyle=1" vertex="1" parent="1">
          <mxGeometry x="1099" y="140" width="300" height="90" as="geometry" />
