        <!-- Agent -> skill arrows -->
        <mxCell id="e_build_current" style="edgeStyle=none;rounded=0;strokeColor=#3457C9;strokeWidth=2;endArrow=block;endFill=1;html=1;exitX=0.5;exitY=1;entryX=0.5;entryY=0" edge="1" parent="1" source="agentBuild" target="skillCurrentState">
